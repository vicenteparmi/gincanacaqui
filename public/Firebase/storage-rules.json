rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in [
          "fEiVGYL79XMbAzk7VQba3Vvezi42",
          "Ge5TjRvSwFZNYTGCPJdH5mQu1b73",
          "xnQA3IDbzrRZwvPn81NhnSKYkY62"
        ];
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }

    match /review/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /user_photos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024;
    }

    match /activity/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /image/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
